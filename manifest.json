{
  "manifest_version": 3,
  "name": "Best Speed (CrowdWorks / Lancers / Coconala)",
  "version": "0.1.0",
  "description": "Watches job search pages and sends template-based proposals to new jobs.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://crowdworks.jp/*",
    "https://www.lancers.jp/*",
    "https://coconala.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crowdworks.jp/*",
        "https://www.lancers.jp/*",
        "https://coconala.com/*"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Best Speed",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon.png"
  }
}
